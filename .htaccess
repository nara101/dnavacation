RewriteEngine On
RewriteBase /dna-vacation/

# Block access to sensitive files
<FilesMatch "\.(sql|md|txt|log)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block directory listing
Options -Indexes

# PHP settings
php_value upload_max_filesize 10M
php_value post_max_size 12M
php_value max_execution_time 300
